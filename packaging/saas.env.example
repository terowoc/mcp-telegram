# Server-only credentials. Never pass these values to the browser build.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
MCP_PUBLIC_URL=https://tg-mcp.example.com
MCP_HTTP_PORT=3000
# All paths must be absolute. Keep the stable key outside the database snapshot directory.
MCP_AUTH_DIR=/data/auth
MCP_SESSION_KEY_FILE=/run/secrets/telegram-session.key
MCP_TELEGRAM_FILE_ROOT=/data/files
MCP_SAAS_MAX_USERS=100
MCP_SAAS_MAX_WORKERS=4
# No TELEGRAM_2FA_PASSWORD: each QR attempt accepts its own transient password.
